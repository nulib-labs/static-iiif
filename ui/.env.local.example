# Copy to .env.local (gitignored) and fill in from your personal stack's outputs:
#   aws cloudformation describe-stacks --stack-name <your-stack-name> --query 'Stacks[0].Outputs'
#
# Mapping from CloudFormation output key -> variable:
#   IiifEndpoint            -> VITE_IIIF_BASE_URL
#   ManifestApiUrl          -> VITE_MANIFEST_API_URL (append /manifests)
#   ManifestApiUrl          -> VITE_SEARCH_API_URL (append /search — only if this stack has OpenSearch configured)
#   IIIFBucketName          -> VITE_STORAGE_BUCKET
#   SourceBucketName        -> VITE_SOURCE_BUCKET
#   CognitoIdentityPoolId   -> VITE_STORAGE_IDENTITY_POOL_ID
#   CognitoUserPoolId       -> VITE_COGNITO_USER_POOL_ID
#   CognitoClientId         -> VITE_COGNITO_CLIENT_ID

VITE_IIIF_BASE_URL=
VITE_MANIFEST_API_URL=
VITE_SEARCH_API_URL=
VITE_STORAGE_BUCKET=
VITE_SOURCE_BUCKET=
VITE_STORAGE_REGION=us-east-1
VITE_STORAGE_IDENTITY_POOL_ID=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
