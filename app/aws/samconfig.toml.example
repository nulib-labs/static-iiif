version = 0.1

[default.deploy.parameters]
# Pick a stack name unique to you — this becomes your personal dev stack.
# e.g. "jsmith-dev-static-iiif". Everyone on the team deploys their own copy
# of this stack rather than sharing one.
stack_name = "<your-username>-dev-static-iiif"
resolve_s3 = true
region = "us-east-1"
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND"

# GitHub repo URL — the URL of your GitHub fork of this repository
# GitHub personal access token — needs "repo" scope
#   Generate one at: https://github.com/settings/tokens → Generate new token (classic) → check "repo"
# GitHub branch to deploy (default: main)
#
# OpenSearch parameters are REQUIRED. The collection works list is served by
# the search index, so a stack without one cannot list anything. Point at an
# existing shared domain — this repo does not provision one.
#
# SearchIndexPrefix is optional and defaults to the stack name. It must be
# lowercase: index names are built as <prefix>._working and
# <prefix>.<slug>._pub.<runId>, with <prefix>.<slug> as the alias a consuming
# site points at.
#
# After deploying, read the OpenSearchAccessRoleArn stack output and add it to
# that domain's access policy yourself. It is one ARN — PublishFunction shares
# ManifestFunction's role so that it stays one.
parameter_overrides = "GitHubRepo=https://github.com/your-org/your-repo GitHubOAuthToken=ghp_your_token_here GitHubBranch=main OpenSearchDomainName=your-domain-name OpenSearchEndpoint=https://search-your-domain-xxxx.us-east-1.es.amazonaws.com"
